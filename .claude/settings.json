{
  "permissions": {
    "ask": [
      "Bash(*git stash pop*)",
      "Bash(*git stash apply*)",
      "Bash(*git add*)",
      "Bash(*git -* add*)",
      "Bash(*git stage*)",
      "Bash(*git -* stage*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/harness/session-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
