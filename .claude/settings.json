{
  "permissions": {
    "ask": [
      "Bash(*git pull*)",
      "Bash(*git switch*)",
      "Bash(*git stash pop*)",
      "Bash(*git stash apply*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/harness/session-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
