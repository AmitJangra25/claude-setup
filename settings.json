{
  "cleanupPeriodDays": 60,
  "env": {
    "RTK_HOOK_AUDIT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh run list*)",
      "Bash(rtk --version)",
      "Bash(rtk df *)",
      "Bash(rtk discover*)",
      "Bash(rtk du *)",
      "Bash(rtk find *)",
      "Bash(rtk gain*)",
      "Bash(rtk git branch *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk git rev-parse *)",
      "Bash(rtk git show *)",
      "Bash(rtk git status*)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk proxy cat *)",
      "Bash(rtk proxy find *)",
      "Bash(rtk proxy grep *)",
      "Bash(rtk proxy ls *)",
      "Bash(rtk ps *)",
      "Bash(rtk read *)",
      "Bash(rtk wc *)",
      "Bash(tree *)",
      "Bash(xxd *)",
      "Read(//Users/amitjangra/Library/Application Support/rtk/tee/**)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)"
    ],
    "ask": [
      "Bash(*brew install*)",
      "Bash(*brew reinstall*)",
      "Bash(*brew uninstall*)",
      "Bash(*brew upgrade*)",
      "Bash(*curl *)",
      "Bash(*gem install*)",
      "Bash(*gh api*)",
      "Bash(*gh auth*)",
      "Bash(*gh pr*)",
      "Bash(*gh repo*)",
      "Bash(*git * commit*)",
      "Bash(*git branch --delete*)",
      "Bash(*git branch -D*)",
      "Bash(*git branch -d*)",
      "Bash(*git checkout*)",
      "Bash(*git clean*)",
      "Bash(*git commit*)",
      "Bash(*git merge*)",
      "Bash(*git mv*)",
      "Bash(*git push*)",
      "Bash(*git rebase*)",
      "Bash(*git reset*)",
      "Bash(*git restore*)",
      "Bash(*git rm*)",
      "Bash(*git stash clear*)",
      "Bash(*git stash drop*)",
      "Bash(*npm add*)",
      "Bash(*npm i *)",
      "Bash(*npm i)",
      "Bash(*npm install*)",
      "Bash(*npx --yes*)",
      "Bash(*npx -y*)",
      "Bash(*ollama pull*)",
      "Bash(*ollama rm*)",
      "Bash(*ollama signin*)",
      "Bash(*pip install*)",
      "Bash(*pip3 install*)",
      "Bash(*pnpm add*)",
      "Bash(*pnpm install*)",
      "Bash(*security *)",
      "Bash(*sqlite3 *)",
      "Bash(*sqlite3)",
      "Bash(*sudo *)",
      "Bash(*tccutil*)",
      "Bash(*wget *)",
      "Bash(*yarn add*)",
      "Bash(*yarn install*)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(open *)",
      "Bash(pkill *)",
      "Bash(rm *)",
      "Bash(rtk proxy kill *)",
      "Bash(rtk proxy killall *)",
      "Bash(rtk proxy open *)",
      "Bash(rtk proxy pkill *)",
      "Bash(rtk proxy rm *)",
      "Bash(rtk rm *)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "pptx": "name-only",
    "learn": "name-only",
    "docs": "name-only",
    "doc-coauthoring": "name-only",
    "algorithmic-art": "name-only",
    "canvas-design": "name-only",
    "slack-gif-creator": "name-only",
    "brand-guidelines": "name-only",
    "theme-factory": "name-only",
    "web-artifacts-builder": "name-only",
    "morning": "name-only",
    "internal-comms": "name-only",
    "import-memory": "name-only",
    "mcp-builder": "name-only",
    "skill-creator": "name-only",
    "artifact-design": "name-only",
    "artifact-diagramming": "name-only",
    "artifact-capabilities": "name-only",
    "claude-in-chrome": "name-only",
    "dataviz": "name-only",
    "workflow-authoring": "name-only",
    "google-workspace": "name-only",
    "xlsx": "name-only",
    "docx": "name-only",
    "update-config": "name-only",
    "code-review": "name-only",
    "pdf": "name-only",
    "schedule": "name-only",
    "run": "name-only",
    "loop": "name-only",
    "keybindings-help": "name-only",
    "fewer-permission-prompts": "name-only",
    "simplify": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline/context.py",
    "padding": 0
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "browser-use@synced": false,
    "small-business@synced": false,
    "figma@synced": false,
    "sanity@synced": false,
    "marketing@synced": false,
    "product-management@synced": false,
    "finance@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false,
    "data@synced": false,
    "productivity@synced": false,
    "engineering@synced": false
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: None configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured) — as scoped by the Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository the agent started in (its working directory) and its configured remote(s). Setup work runs in /Users/amitjangra/.claude, a private repo whose remote is github.com/AmitJangra25/claude-setup; project work runs in that project's own repo under /Users/amitjangra/Documents/VS Code/. /Users/amitjangra/Documents itself is not a repo and is not a working directory to start from",
      "**Org-specific CLIs**: `rtk`, a local token-compressing command proxy on PATH — personal tooling, not an org service"
    ]
  }
}
