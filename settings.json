{
  "env": {
    "RTK_HOOK_AUDIT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(rtk --version)",
      "Bash(rtk df *)",
      "Bash(rtk discover*)",
      "Bash(rtk du *)",
      "Bash(rtk find *)",
      "Bash(rtk gain*)",
      "Bash(rtk git branch *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk git rev-parse *)",
      "Bash(rtk git show *)",
      "Bash(rtk git status*)",
      "Bash(rtk grep *)",
      "Bash(rtk ls *)",
      "Bash(rtk proxy cat *)",
      "Bash(rtk proxy find *)",
      "Bash(rtk proxy grep *)",
      "Bash(rtk proxy ls *)",
      "Bash(rtk ps *)",
      "Bash(rtk read *)",
      "Bash(rtk wc *)",
      "Bash(tree *)",
      "Bash(xxd *)",
      "Read(//Users/amitjangra/Library/Application Support/rtk/tee/**)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.android.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)"
    ],
    "ask": [
      "Bash(*curl *)",
      "Bash(*gem install*)",
      "Bash(*gh api*)",
      "Bash(*gh auth*)",
      "Bash(*gh pr*)",
      "Bash(*gh repo*)",
      "Bash(*git * commit*)",
      "Bash(*git branch --delete*)",
      "Bash(*git branch -D*)",
      "Bash(*git branch -d*)",
      "Bash(*git checkout*)",
      "Bash(*git clean*)",
      "Bash(*git commit*)",
      "Bash(*git merge*)",
      "Bash(*git mv*)",
      "Bash(*git push*)",
      "Bash(*git rebase*)",
      "Bash(*git reset*)",
      "Bash(*git rm*)",
      "Bash(*npm add*)",
      "Bash(*npm i *)",
      "Bash(*npm i)",
      "Bash(*npm install*)",
      "Bash(*npx --yes*)",
      "Bash(*npx -y*)",
      "Bash(*ollama pull*)",
      "Bash(*ollama rm*)",
      "Bash(*ollama signin*)",
      "Bash(*pip install*)",
      "Bash(*pip3 install*)",
      "Bash(*pnpm add*)",
      "Bash(*pnpm install*)",
      "Bash(*security *)",
      "Bash(*sqlite3 *)",
      "Bash(*sqlite3)",
      "Bash(*sudo *)",
      "Bash(*tccutil*)",
      "Bash(*wget *)",
      "Bash(*yarn add*)",
      "Bash(*yarn install*)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(open *)",
      "Bash(pkill *)",
      "Bash(rm *)",
      "Bash(rtk proxy kill *)",
      "Bash(rtk proxy killall *)",
      "Bash(rtk proxy open *)",
      "Bash(rtk proxy pkill *)",
      "Bash(rtk proxy rm *)",
      "Bash(rtk rm *)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline/context.py",
    "padding": 0
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark",
  "switchModelsOnFlag": true
}
